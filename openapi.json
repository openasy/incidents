    "/healthz": {
      "get": {
        "operationId": "liveness",
        "tags": [
          "Product"
        ],
        "summary": "Liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "tags": [
          "Product"
        ],
        "summary": "Readiness",
        "description": "Ready while the database answers.",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready to serve.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "tags": [
          "Product"
        ],
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when incidents runs on plain http://localhost). Requests that change something must come from the incidents origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings \u2192 API tokens (`oa_incidents_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when incidents is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "conflict",
              "not-found",
              "payload-too-large",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "open",
          "investigating",
          "mitigated",
          "resolved"
        ]
      },
      "Counts": {
        "type": "object",
        "required": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "additionalProperties": false,
        "properties": {
          "critical": {
            "type": "integer"
          },
          "high": {
            "type": "integer"
          },
          "medium": {
            "type": "integer"
          },
          "low": {
            "type": "integer"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "incidents"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "open",
          "total",
          "resolved90d",
          "meanMinutesToResolve",
          "awaitingPostmortem"
        ],
        "additionalProperties": false,
        "properties": {
          "open": {
            "$ref": "#/components/schemas/Counts"
          },
          "total": {
            "type": "integer"
          },
          "resolved90d": {
            "type": "integer",
            "description": "Incidents resolved in the last 90 days."
          },
          "meanMinutesToResolve": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Mean minutes from opening to resolving over the last 90 days; null without one."
          },
          "awaitingPostmortem": {
            "type": "integer",
            "description": "Resolved incidents without a published postmortem."
          }
        }
      },
      "External": {
        "type": "object",
        "required": [
          "source",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "The product or system that reported it, such as `siem`."
          },
          "reference": {
            "type": "string",
            "description": "Its own id for the report, such as a signal id."
          }
        }
      },
      "TimelineEntry": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text",
          "author",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "status-change",
              "severity-change",
              "link",
              "task-done"
            ]
          },
          "text": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "owner",
          "done",
          "due",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "done": {
            "type": "boolean"
          },
          "due": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "source",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "The product the evidence lives in."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Postmortem": {
        "type": "object",
        "required": [
          "body",
          "status",
          "updatedAt",
          "updatedBy",
          "publishedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string",
            "description": "Markdown."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string"
          },
          "publishedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      },
      "IncidentSummary": {
        "type": "object",
        "required": [
          "id",
          "key",
          "number",
          "title",
          "severity",
          "status",
          "commander",
          "summary",
          "products",
          "external",
          "openTasks",
          "createdAt",
          "updatedAt",
          "resolvedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "description": "INC-12: what people say, and what the API accepts in place of the id."
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "commander": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/External"
              }
            ]
          },
          "openTasks": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      },
      "IncidentList": {
        "type": "object",
        "required": [
          "incidents"
        ],
        "properties": {
          "incidents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncidentSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewIncident": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "medium"
          },
          "commander": {
            "type": "string",
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          },
          "products": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "external": {
            "$ref": "#/components/schemas/External",
            "description": "Set by a product that opens incidents. The same source and reference is one incident; asking again adds a note to its timeline and answers 200."
          }
        }
      },
      "UpdateIncident": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "commander": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 100
              }
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          },
          "products": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      },
      "NewTimelineEntry": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "link"
            ],
            "default": "note"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "NewTask": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "owner": {
            "type": "string",
            "maxLength": 100
          },
          "due": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateTask": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "owner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 100
              }
            ]
          },
          "due": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "NewEvidence": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "http or https, without credentials. It is kept as a link; nothing is fetched."
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "PutPostmortem": {
        "type": "object",
        "required": [
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 50000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "default": "draft"
          }
        }
      },
      "Incident": {
        "type": "object",
        "required": [
          "id",
          "key",
          "number",
          "title",
          "severity",
          "status",
          "commander",
          "summary",
          "products",
          "external",
          "openTasks",
          "createdAt",
          "updatedAt",
          "resolvedAt",
          "timeline",
          "tasks",
          "evidence",
          "postmortem"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "description": "INC-12: what people say, and what the API accepts in place of the id."
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "commander": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/External"
              }
            ]
          },
          "openTasks": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineEntry"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "postmortem": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Postmortem"
              }
            ]
          }
        }
      }
    }
  }
}
